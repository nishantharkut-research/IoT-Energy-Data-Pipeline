{
  "name": "iot-energy-review-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "evidence": "cd ../.. && python3 -m scripts.export_dashboard_evidence",
    "predev": "npm run evidence",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "prebuild": "npm run evidence",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "test": "vitest run",
    "format": "prettier --check src vite.config.ts",
    "check": "npm test && npm run build && npm run format"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
